# Copy to deploy/.env. Never commit the real file.
DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_PASSWORD=replace-with-a-long-random-app-password
JWT_SECRET=replace-with-at-least-32-random-characters
AICAP_LLM_API_KEY=replace-with-provider-api-key
AICAP_LLM_BASE_URL=https://api.deepseek.com
AICAP_LLM_MODEL=deepseek-v4-flash

# Optional. Leave PROFILE_LLM_API_KEY empty to keep profile-model calls disabled.
PROFILE_LLM_API_KEY=
PROFILE_LLM_BASE_URL=https://api.deepseek.com
PROFILE_LLM_MODEL=deepseek-v4-flash
AICAP_AGENT_WORKER_ENABLED=true

# Optional GitHub activity sync for US34-US37. Keep the real token in deploy/.env.
GITHUB_ENABLED=false
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_PROJECT_ID=
GITHUB_USER_MAPPING=
GITHUB_AUTO_SYNC_HOURS=0

# 演示与验收需要预置账号；生产环境请设为 false 或删除该行。
# Demo/acceptance runs need the seeded accounts (5 demo users with password
# 123456, 37 stories, 16 tasks); compose.yaml defaults this switch to false.
AICAP_SEED_ON_START=true
AICAP_HTTP_PORT=8088
AICAP_BIND_ADDRESS=127.0.0.1
