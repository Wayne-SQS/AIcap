# 编排层配置模板。复制为 .env 后按需修改；.env 已被根 .gitignore 忽略。
# 密钥一律留空默认，由环境变量注入，绝不落盘。

# Java 平台地址（唯一上游，编排层一切数据都经它取）
JAVA_BASE_URL=http://127.0.0.1:8080

# 编排层自身监听端口（契约 §8 待拍板 #2 的建议值）
PORT=8100

# 调用 Java 的超时（秒）
JAVA_TIMEOUT=30

# LLM 提供方：S4′.2 的有界循环才用到，S4′.1 不发起任何模型调用。
# 留空即视为未配置；编排层不会用假数据顶上。
AICAP_LLM_API_KEY=
AICAP_LLM_BASE_URL=https://api.deepseek.com
AICAP_LLM_MODEL=deepseek-v4-flash

# 单次模型调用的超时（秒）。循环的 180s 总预算是另一回事，由 loop 的 deadline 管。
AICAP_LLM_TIMEOUT=60

# 反问阈值（契约 §5.4：confidence 低于它就去问用户，而不是瞎猜）。
# **写在代码里、可配置**；prompt 里不含这个数，所以调它不必改 prompt。
AICAP_CLARIFY_CONFIDENCE=0.6

# SSE 心跳间隔（秒）。反代默认 60s 断空连接，15s 留足余量。
SSE_HEARTBEAT_SECONDS=15

# SSE 事件单次读取的页大小。Java 侧不传 limit 时一页 500 条、上限 1000
# （AgentEventService.DEFAULT_LIMIT / MAX_LIMIT）；编排层只要一小页，
# 由 /chat/stream 的循环带着新的 after_seq 续读下一页。
SSE_EVENT_PAGE_LIMIT=100
