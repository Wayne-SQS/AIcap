# ============================================================================
# AIcap 环境变量模板
# ============================================================================
# 用法:复制本文件为 .env(已被 .gitignore 忽略),填入真实值;
#       或者不建文件,直接把同名变量配成系统/用户环境变量。
#
# ⚠️ 本文件只放变量名与说明,任何真实密钥都不要写进来。
#    仓库是公开仓库:密钥一旦进入 git 历史,即使后续提交删除也能被翻出来,
#    唯一补救是立刻去平台吊销并重发。真实值只存在于部署机的环境变量中。
# ============================================================================

# --- 画像智能体 LLM(独立前缀,不与会议智能体共用) -------------------------
# 不配则画像分析静默降级为规则引擎(engine=rules_fallback),不会伪造模型结论
PROFILE_LLM_API_KEY=
PROFILE_LLM_BASE_URL=https://api.deepseek.com
PROFILE_LLM_MODEL=deepseek-chat
# 批量难度评估:单次请求合并的任务数;太大易超输出上限导致 JSON 截断
PROFILE_LLM_BATCH_SIZE=8
# false = 回退为逐任务的规划循环(旧行为),用于灰度对照
PROFILE_LLM_BATCH_ENABLED=true

# --- 会议智能体 / RAG 精排 LLM ---------------------------------------------
AICAP_LLM_API_KEY=
AICAP_LLM_BASE_URL=https://api.deepseek.com
AICAP_LLM_MODEL=deepseek-v4-flash

# --- GitHub 活动同步 -------------------------------------------------------
GITHUB_ENABLED=false
# fine-grained PAT,只需只读权限:Contents / Pull requests / Issues
# 生成入口: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# 仓库 owner/repo
GITHUB_REPO=
# 单仓库部署的显式项目归属(如 P002);仅当同步仓库 == GITHUB_REPO 时生效,
# repository-project-mapping 优先。多项目场景不要设置此项
GITHUB_PROJECT_ID=
# GitHub 登录名 -> 系统成员真名(JSON 单行)
GITHUB_USER_MAPPING={"your-github-login":"李锐铭"}
# 0 = 不启用定时同步,只靠成员动作触发(推荐)
GITHUB_AUTO_SYNC_HOURS=0

# --- 数据库(本地用 Docker 起的 aiguanli-mysql:3307) ----------------------
DB_URL=jdbc:mysql://127.0.0.1:3307/AIcap?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=aiguanli
DB_PASSWORD=
# 后端端口。注意:环境里若存在 SERVER__PORT(双下划线,Spring 宽松绑定等价 SERVER_PORT),
# 会覆盖默认值导致端口被莫名占用,启动时建议显式指定 --server.port=8080
SERVER_PORT=8080
